# =============================================================================
# TidaLine Lakehouse — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- Database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=maritime_logistics

# --- Object Storage (MinIO / S3) ---
MINIO_ROOT_USER=<your-minio-user>
MINIO_ROOT_PASSWORD=<your-minio-password>
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tidaline-lakehouse
AWS_ACCESS_KEY_ID=<same-as-MINIO_ROOT_USER>
AWS_SECRET_ACCESS_KEY=<same-as-MINIO_ROOT_PASSWORD>
AWS_REGION=us-east-1

# --- Monitoring & BI ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<your-grafana-password>
SUPERSET_SECRET_KEY=<generate-a-random-secret-key>

# --- Trino ---
TRINO_USER=admin
